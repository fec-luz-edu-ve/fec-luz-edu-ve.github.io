---
import '../styles/global.css';
import {navigation} from '../data/portal';
interface Props {title:string; description?:string;}
const {title,description='Portal institucional de la Facultad Experimental de Ciencias de la Universidad del Zulia.'}=Astro.props;
const current=Astro.url.pathname;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title} · FEC-LUZ</title><link rel="icon" href="/logos/fec-transparente.png"/></head><body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<div class="university"><div class="container">UNIVERSIDAD DEL ZULIA <span>Conocimiento al servicio de la sociedad</span></div></div>
<header><div class="container brand-row"><a class="brand" href="/" aria-label="FEC-LUZ, inicio"><img class="luz-mark" src="/logos/luz-transparente.png" alt="Escudo de la Universidad del Zulia" width="51" height="64"/><span>Facultad Experimental<small>de Ciencias</small></span></a><img class="fec-mark" src="/logos/fec-transparente.png" alt="Emblema de la Facultad Experimental de Ciencias" width="74" height="60"/></div>
<nav class="container" aria-label="Navegación principal"><details class="mobile-menu"><summary>Menú de navegación</summary><div>{navigation.map(([name,slug])=><a href={`/${slug}/`} aria-current={current.startsWith(`/${slug}/`)?'page':undefined}>{name}</a>)}</div></details><div class="desktop-nav">{navigation.map(([name,slug])=><a href={`/${slug}/`} aria-current={current.startsWith(`/${slug}/`)?'page':undefined}>{name}</a>)}</div></nav></header>
<main id="contenido" tabindex="-1"><slot/></main>
<footer><div class="container footer-grid"><div><p class="footer-title">Facultad Experimental de Ciencias</p><p>Universidad del Zulia<br/>Maracaibo, Venezuela</p></div><div><p class="footer-title">Servicios académicos</p><a href="https://wde.secretarialuz.org/">Web del Estudiante ↗</a><a href="/postgrado/">Postgrado y formularios</a><a href="/normativa/">Normativa y Reglamentos</a><a href="/contacto/">Contacto institucional</a></div><div><p class="footer-title">Conecta con la Facultad</p><a href="https://www.instagram.com/fec_luz/">Instagram · @fec_luz ↗</a><a href="https://produccioncientificaluz.org/">Publicaciones científicas ↗</a><a href="https://produccioncientificaluz.org/index.php/rluz">Revista de la Universidad del Zulia ↗</a></div></div><div class="container footer-bottom">FEC · LUZ <span>Portal institucional · Versión inicial para revisión</span></div></footer>
</body></html>