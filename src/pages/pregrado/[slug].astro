---
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import {degrees} from '../../data/portal';
export function getStaticPaths(){return degrees.map(d=>({params:{slug:d.slug},props:{degree:d}}));}
const {degree:d}=Astro.props;const url=`/documentos/pregrado/${d.file}`;
---
<Layout title={`Licenciatura en ${d.name}`}><PageIntro title={`Licenciatura en ${d.name}`} kicker="PREGRADO"/><section class="section container reading"><h2>Malla curricular</h2><p>Documento curricular proporcionado para consulta académica. Confirme con la Facultad la versión aplicable a su cohorte.</p>{['matematica','antropologia'].includes(d.slug)&&<p class="notice">La vigencia actual de esta malla curricular está pendiente de confirmación institucional.</p>}<div class="actions"><a class="button" href={url}>Abrir documento ↗</a><a href={url} download>Descargar original</a></div>{d.file.endsWith('.jpg')?<a href={url} aria-label="Abrir imagen curricular a tamaño completo"><img class="curriculum" src={url} alt={`Pensum de estudio de la Licenciatura en ${d.name}; disponible para ampliar o descargar`} loading="lazy"/></a>:<p class="note">Documento PDF. Puede abrirlo en el navegador o descargarlo mediante los enlaces anteriores.</p>}{d.slug==='computacion'&&<aside class="notice"><h2>Departamento de Computación</h2><a href="https://github.com/FEC-LUZ-Computacion">Consultar organización departamental ↗</a><p>El enlace al portal departamental se incorporará al confirmar su disponibilidad.</p></aside>}</section></Layout>
