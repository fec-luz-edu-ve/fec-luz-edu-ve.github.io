---
import Layout from '../layouts/Layout.astro';
import Calendar from '../components/Calendar.astro';
import {degrees,journals} from '../data/portal';
---
<Layout title="Inicio"><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">UNIVERSIDAD DEL ZULIA · FEC</p><h1>La ciencia nos<br/>abre caminos.</h1><p>Facultad Experimental de Ciencias</p><p class="hero-description">Un espacio universitario para la formación académica, la investigación y la vinculación con la sociedad.</p><div class="actions"><a class="button" href="/pregrado/">Explora nuestra oferta académica <span aria-hidden="true">↗</span></a><a class="text-link" href="/decanato/">Conoce la Facultad →</a></div></div><figure><img src="/imagenes/fachada.webp" alt="Fachada de la Facultad Experimental de Ciencias, con acceso por escaleras y rampa" width="495" height="619" fetchpriority="high"/><figcaption>Facultad Experimental de Ciencias · Universidad del Zulia</figcaption></figure></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">FORMACIÓN DE PREGRADO</p><h2>Seis disciplinas.<br/>Un universo por descubrir.</h2></div><a href="/pregrado/">Ver todas las licenciaturas →</a></div><div class="degree-grid">{degrees.map(d=><a class="degree" href={`/pregrado/${d.slug}/`}><h3>{d.name}</h3><p>{d.area}</p><span class="degree-link">Malla curricular <span aria-hidden="true">↗</span></span></a>)}</div></section>
<section class="pathways"><div class="container pathway-grid">{[['01','Postgrado','Continúa tu formación académica.','postgrado'],['02','Investigación','Consulta nuestras publicaciones científicas.','investigacion'],['03','Extensión','Conecta con educación continua y UDESA.','extension']].map(([n,title,desc,slug])=><a href={`/${slug}/`}><span>{n} /</span><h2>{title} ↗</h2><p>{desc}</p></a>)}</div></section>
<section class="section container two-column"><div><p class="eyebrow">AGENDA ACADÉMICA</p><h2>Fechas para<br/>tener presentes.</h2><p>Información de inscripción y actividades académicas documentadas.</p><a href="/secretaria-docente/">Secretaría Docente →</a></div><div><Calendar upcoming/></div></section>
<section class="soft section"><div class="container two-column"><div><p class="eyebrow">ACTUALIDAD</p><h2>Información institucional</h2><p>Consulta los canales de la Facultad y los avisos académicos disponibles.</p><a href="/actualidad/">Ver actualidad →</a></div><aside class="notice"><p class="eyebrow">EVENTO REALIZADO · 4–6 NOV 2026</p><h3>Semana LICOM 2026</h3><p>Charlas, tecnología para la inclusión, programación y actividades deportivas en la Facultad.</p><a href="/actualidad/semana-licom-2026/">Consultar agenda y afiches →</a></aside></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">CONOCIMIENTO QUE SE COMPARTE</p><h2>Publicaciones científicas</h2></div><a href="/investigacion/">Explorar publicaciones →</a></div><div class="journal-list">{journals.map(journal=><a href={journal.url}>{journal.name}<span aria-hidden="true">↗</span></a>)}</div><p class="note">Enl@ce se presenta como referencia histórica; su actividad editorial actual está pendiente de verificación.</p></section>
<section class="quick container"><h2>Accesos universitarios</h2><a href="https://wde.secretarialuz.org/">Web del Estudiante ↗</a><a href="https://sedluz.net/">SEDLUZ · Educación a distancia ↗</a><a href="http://www.servicios.luz.edu.ve/Seguridad/login.php">Servicios LUZ ↗</a><a href="https://maestriaentic-luz.github.io/">Maestría TIC ↗</a><a href="https://sites.google.com/fec.luz.edu.ve/udesa/contactos">UDESA ↗</a></section></Layout>
