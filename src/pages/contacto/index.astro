---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import {institutionalContacts,postgraduate} from '../../data/portal';
---
<Layout title="Contacto"><PageIntro title="Contacto" intro="Canales administrativos y académicos documentados."/><section class="section container reading"><h2>Facultad Experimental de Ciencias</h2><p>Universidad del Zulia · Maracaibo, Venezuela.</p><h2>División de Estudios para Graduados</h2><a href={`mailto:${institutionalContacts.postgraduateDivision}`}>{institutionalContacts.postgraduateDivision}</a><h3>Secretaría de Postgrado</h3><a href={`mailto:${institutionalContacts.postgraduateSecretary}`}>{institutionalContacts.postgraduateSecretary}</a><h3>Contactos de programas</h3><dl class="editorial-contacts">{postgraduate.filter(p=>p.email).map(p=><><dt>{p.name}{p.name.includes('Comunicación')?' · Admisión':''}</dt><dd><a href={`mailto:${p.email}`}>{p.email}</a></dd></>)}</dl><a href="/postgrado/#coordinaciones">Consultar directorio de coordinaciones →</a><h2>Revista CIENCIA</h2><dl class="editorial-contacts"><dt>Contacto de la revista</dt><dd><a href={`mailto:${institutionalContacts.ciencia}`}>{institutionalContacts.ciencia}</a></dd><dt>Recepción de artículos</dt><dd><a href={`mailto:${institutionalContacts.cienciaSubmissions}`}>{institutionalContacts.cienciaSubmissions}</a></dd></dl><h2>Extensión · UDESA</h2><a href="https://sites.google.com/fec.luz.edu.ve/udesa/contactos">Consultar contactos de UDESA ↗</a><h2>Red institucional</h2><a href="https://www.instagram.com/fec_luz/">Instagram · @fec_luz ↗</a><p class="note">La dirección detallada y los horarios de atención están pendientes de confirmación.</p></section></Layout>
