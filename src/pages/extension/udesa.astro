---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { cursosUDESA, categoriasUDESA, catalogoPDF, portalUDESA } from '../../data/cursos-udesa';
---
<Layout title="UDESA · Formación Continua" description="Explora diez cursos certificados en tecnologías avanzadas del catálogo UDESA de FEC-LUZ.">
  <PageIntro title="UDESA · Formación Continua" intro="Cursos certificados en tecnologías avanzadas" />
  <div class="container udesa">
    <a class="breadcrumb" href="/extension/">Volver a Extensión</a>
    <section aria-labelledby="presentacion">
      <h2 id="presentacion">Formación para la transformación tecnológica</h2>
      <p class="reading">La oferta de cursos especializados de UDESA, en la Facultad Experimental de Ciencias de la Universidad del Zulia, está diseñada para impulsar el perfil profesional y liderar la transformación digital e inteligencia artificial.</p>
      <div class="actions">
        <a class="button" href={catalogoPDF} target="_blank" rel="noopener">Consultar catálogo PDF <span class="sr-only">(abre en una nueva pestaña)</span> ↗</a>
        <a href={catalogoPDF} download="catalogo-udesa-v1.pdf">Descargar catálogo</a>
      </div>
    </section>
    <section aria-labelledby="cursos">
      <p class="eyebrow">CATÁLOGO UDESA V1</p>
      <h2 id="cursos">Explora los cursos</h2>
      <p>Consulta la descripción de cada curso. Las fechas y la disponibilidad se confirman directamente con UDESA.</p>
      <form class="filters" role="search" aria-label="Buscar cursos" hidden>
        <div><label for="categoria">Área temática</label><select id="categoria" name="categoria"><option value="">Todos los cursos</option>{categoriasUDESA.map(c=><option value={c}>{c}</option>)}</select></div>
        <div><label for="busqueda">Buscar por nombre o descripción</label><input type="search" id="busqueda" name="busqueda" placeholder="Por ejemplo, Python" /></div>
        <button type="reset">Restablecer</button>
      </form>
      <p class="note">Áreas temáticas organizadas por el portal para facilitar la consulta.</p>
      <p id="resultados" role="status" aria-live="polite" aria-atomic="true">10 cursos en el catálogo</p>
      <div class="course-grid">
        {cursosUDESA.map(c=><article class="course" id={c.slug} data-course data-category={c.categoria} data-search={`${c.titulo} ${c.descripcion} ${c.categoria}`}>
          <p class="category">{c.categoria}</p>
          <h3>{c.titulo}</h3>
          <p class="metadata"><strong>{c.horasAcademicas} horas académicas</strong><br/>Curso certificado · En catálogo</p>
          <details><summary>Ver detalles<span class="sr-only">: {c.titulo}</span></summary>
            <p>{c.descripcion}</p>
            <p>El catálogo contempla certificados de aprobación o asistencia. Consulta con UDESA las condiciones de certificación de este curso.</p>
            <a href={`${catalogoPDF}#page=${c.paginaCatalogo}`} target="_blank" rel="noopener">Consultar página {c.paginaCatalogo} del catálogo PDF<span class="sr-only"> (abre en una nueva pestaña)</span> ↗</a>
          </details>
        </article>)}
      </div>
      <p id="sin-resultados" class="notice" hidden>No se encontraron cursos con estos criterios. Prueba otra búsqueda o restablece los filtros.</p>
    </section>
    <section class="notice" aria-labelledby="modalidades">
      <h2 id="modalidades">Modalidades y certificación</h2>
      <p>UDESA presenta formación online e in-company, así como certificados de aprobación o asistencia. Son características generales de su oferta; consulta la modalidad y las condiciones de certificación disponibles para cada curso.</p>
    </section>
    <section aria-labelledby="contacto" class="contact">
      <h2 id="contacto">Consulta con UDESA</h2>
      <p>Solicita información sobre fechas, disponibilidad, costos e instructores.</p>
      <div class="actions"><a class="button" href="mailto:udesa@fec.luz.edu.ve">Contactar a UDESA</a><a href={portalUDESA}>Visitar el portal oficial de UDESA ↗</a></div>
      <p><a href="mailto:udesa@fec.luz.edu.ve">udesa@fec.luz.edu.ve</a></p>
    </section>
  </div>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('.filters');
  const category = document.querySelector<HTMLSelectElement>('#categoria');
  const search = document.querySelector<HTMLInputElement>('#busqueda');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-course]')];
  const status = document.querySelector('#resultados');
  const empty = document.querySelector<HTMLElement>('#sin-resultados');
  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();
  function filterCourses() {
    if (!category || !search) return;
    const query = normalize(search.value);
    let count = 0;
    for (const card of cards) {
      card.hidden = !!(category.value && card.dataset.category !== category.value) || !normalize(card.dataset.search ?? '').includes(query);
      if (!card.hidden) count++;
    }
    if (status) status.textContent = `${count} ${count === 1 ? 'curso encontrado' : 'cursos encontrados'}`;
    if (empty) empty.hidden = count > 0;
  }
  if (form) {
    form.hidden = false;
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('input', filterCourses);
    form.addEventListener('change', filterCourses);
    form.addEventListener('reset', () => setTimeout(filterCourses, 0));
  }
</script>
<style>
  .udesa{padding-block:30px 60px}.udesa section+section{margin-top:55px}.udesa h2{font-size:clamp(1.7rem,3vw,2.4rem)}
  .filters:not([hidden]){display:flex;align-items:end;gap:20px;flex-wrap:wrap;background:var(--paper);padding:24px;border:1px solid var(--line);border-radius:4px}
  .filters div{flex:1 1 260px}.filters label{display:block;font-weight:600;margin-bottom:10px;font-size:.9rem}
  input,select,button{font:inherit;min-height:48px;border:1px solid var(--muted);border-radius:3px;padding:10px 12px;background:white;color:var(--ink)}input,select{width:100%}button{cursor:pointer;color:var(--blue);font-weight:600}
  .course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}.course{padding:26px;border:1px solid var(--line);border-top:4px solid var(--secondary);border-radius:4px;overflow-wrap:anywhere}.course h3{font-size:1.4rem}.category{font-size:.78rem;font-weight:600;color:var(--secondary)}.metadata{font-size:.85rem;color:var(--muted)}details{border-top:1px solid var(--line)}summary{cursor:pointer;color:var(--blue);padding-block:16px;font-weight:600}details p,details a{font-size:.9rem}details a{display:inline-block;margin-bottom:10px}.contact a{overflow-wrap:anywhere}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  @media(max-width:950px){.course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.course-grid{grid-template-columns:1fr}.filters{padding:18px}.course{padding:22px}.actions{align-items:start;flex-direction:column}}
</style>
